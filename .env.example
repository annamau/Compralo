# Cómpralo — plantilla de entorno del monorepo.
# Copia a `.env` y rellena solo las claves de tu carril.
# NUNCA commitees `.env`. Ninguna clave live: hoy nadie corre en producción.
# ─── P1 · backend/ (Rust) ────────────────────────────────────────────────
# Base SQLite de monitores, ofertas, jobs e historial de ejecución.
DATABASE_URL=sqlite://buy-agent.sqlite?mode=rwc
# Dirección HTTP que expone el servidor Axum.
BIND_ADDR=127.0.0.1:3000
# Filtro de tracing (opcional).
RUST_LOG=server=info,tower_http=info
# Requerido. Solo como fallback cuando un crawl directo es bloqueado o falla.
SPIDER_CLOUD_API_KEY=replace-with-your-spider-cloud-key
# ─── P2 · extension/ (Chrome MV3) ────────────────────────────────────────
# true = fixtures estáticos de mocks/ y fixtures/. false = backend real.
VITE_MOCK=true
VITE_API_URL=http://127.0.0.1:3000
# ─── P3 · intelligence/ ──────────────────────────────────────────────────
# Clave del modelo para /understand y /adjudicate.
ANTHROPIC_API_KEY=replace-with-your-model-key
# Búsqueda semántica cross-retailer para /discover.
EXA_API_KEY=replace-with-your-exa-key
# 1 = responde desde mocks/ en lugar de llamar al modelo.
MOCK=1
# ─── P4 · money/ (Stripe) ────────────────────────────────────────────────
# SOLO claves de test: money.mjs se niega a arrancar si no empieza por sk_test_.
STRIPE_SECRET_KEY=sk_test_replace-with-your-test-key
# SQLite database used for monitors, offers, jobs, and execution history.
# HTTP address exposed by the Axum server.
# Optional tracing filter.
# Required. Used only as a fallback when a direct crawl is blocked or fails.
# Who places the order and holds the money.
#   demo  in-process, spends nothing, drives /v1/demo/scenarios (default)
#   p4    the P4 money service: Stripe mandate hold + aggregator checkout
MERCHANT=demo
# P4 money service. Only read when MERCHANT=p4.
P4_URL=http://localhost:4242
# Let MERCHANT=p4 also accept the "demo" retailer, so the demo script can run
# against P4. Off by default.
P4_DEMO_FALLBACK=0
