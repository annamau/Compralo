# Copy to .env — the backend loads it at boot. Both keys are optional:
# without ANTHROPIC_API_KEY the backend runs in hardcoded-fixture mode,
# without STRIPE_SECRET_KEY it runs a Stripe stub. The demo works in both.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
MARKET_URL=http://localhost:4000
PORT=3000
POLL_INTERVAL_MS=3000

# Exa — real-web offer discovery. Without EXA_API_KEY the Exa source is off and the
# simulator demo is unaffected. Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
EXA_POLL_INTERVAL_MS=60000
EXA_DISCOVERY_TTL_MS=3600000
EXA_MAX_SELLERS=5
EXA_PAGE_CHARS=8000
# Comma-separated domain allowlist, e.g. scan.co.uk,overclockers.co.uk. Empty = whole web.
EXA_DOMAINS=
