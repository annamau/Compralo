# Copy to .env — the backend loads it at boot.
#
# ANTHROPIC_API_KEY is optional: without it the backend runs in hardcoded-fixture mode.
# There is NO Stripe key here. AutoBuy holds no payment credentials: every hold, capture,
# release and aggregator order goes through P4's money service, which owns the keys.
# The backend refuses to boot if P4 is unreachable — start it first: cd money && npm start
ANTHROPIC_API_KEY=

# P4 money service (money/money.mjs). Holds, captures, releases, Zinc orders.
P4_URL=http://localhost:4242

MARKET_URL=http://localhost:4000
PORT=3000
POLL_INTERVAL_MS=3000

# Exa — real-web offer discovery. Without EXA_API_KEY the Exa source is off and the
# simulator demo is unaffected. Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
EXA_POLL_INTERVAL_MS=60000
EXA_DISCOVERY_TTL_MS=3600000
EXA_MAX_SELLERS=5
EXA_PAGE_CHARS=8000
# Comma-separated domain allowlist, e.g. scan.co.uk,overclockers.co.uk. Empty = whole web.
EXA_DOMAINS=
