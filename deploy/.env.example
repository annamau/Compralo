# Compralo deployment environment.
#
#   cp deploy/.env.example deploy/.env      then fill it in
#
# deploy/.env is gitignored and is the ONLY place a real key belongs. It is rsynced
# to the VM by `./deploy/gcp.sh push` and read by compose at `up` time; nothing here
# is ever baked into an image layer.
#
# Values below are intentionally empty. See deploy/README.md § Credentials for where
# each one comes from and which ones the demo can run without.

# ---- required: the money service refuses to boot without both ------------------
# Stripe TEST secret key. Must start with sk_test_ — money.mjs exits otherwise.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Zinc SANDBOX key. Must start with zn_test_ — zinc.mjs exits otherwise.
#   curl -s -X POST https://api.zinc.com/sandbox/keys | python3 -m json.tool
# No account, no personal data. Sandbox keys expire after 7 idle days.
ZINC_API_KEY=

# ---- required: P1's core refuses to start without it ---------------------------
# Spider Cloud key, the fallback crawler when a direct fetch is blocked.
# https://spider.cloud
SPIDER_CLOUD_API_KEY=

# ---- AI: configure OpenRouter or Anthropic for real product reading ------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_MODEL_FALLBACK=

# Optional sandbox demo-store hostname, e.g. 34-175-42-226.sslip.io
SANDBOX_RETAILERS=

# Without either AI key, product reading falls back to fixtures.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Absent -> the Exa perception lane reports mode "off" and finds no real offers.
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ---- edge ----------------------------------------------------------------------
# Leave empty for plain HTTP on the VM's external IP.
# Set a hostname for automatic HTTPS. With no domain to hand, use sslip.io with the
# static IP that `./deploy/gcp.sh create` prints, dashes for dots:
#   DOMAIN=34-175-42-226.sslip.io
DOMAIN=

# ---- GCP: consumed by deploy/gcp.sh, not by the containers ----------------------
# Defaults to `gcloud config get-value project` when left empty.
GCP_PROJECT=
GCP_REGION=europe-southwest1
GCP_ZONE=europe-southwest1-a
GCP_VM_NAME=compralo
GCP_MACHINE_TYPE=e2-small
GCP_BOOT_DISK_GB=30

# ---- where P4's service lives ---------------------------------------------------
# `money/` since the directory-structure merge; `p4/` before it. The whole directory is
# copied into the image, so zinc.mjs travels with money.mjs wherever it ends up.
# See deploy/README.md § 0.
MONEY_DIR=money

# ---- tuning (defaults are fine) ------------------------------------------------
# P4_URL is where the backend's hold/capture lane will point once it stops calling
# Stripe directly. Inside compose the money service answers on its own name.
P4_URL=http://money:4242
POLL_INTERVAL_MS=3000
EXA_POLL_INTERVAL_MS=60000
RUST_LOG=server=info,tower_http=info
