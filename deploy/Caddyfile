# Compralo edge.
#
# SITE_ADDRESS comes from compose: ${DOMAIN:-:80}.
#   a hostname -> Caddy provisions a certificate over ACME and redirects :80 to :443
#   :80        -> plain HTTP on the VM's external IP, no certificate, no DNS needed
#
# No domain, but you still want HTTPS? sslip.io resolves <dashed-ip>.sslip.io to that
# IP, so DOMAIN=34-175-42-226.sslip.io gets a real certificate with no DNS to buy.
# That is what P1's existing VM already does; see deploy/gcp-startup.sh.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /products/ps5-slim {
		reverse_proxy demo-store:4011
	}

	# Rust is the sole owner of monitors, authorization and checkout.
	handle /understand {
		reverse_proxy backend:3000
	}
	handle /usage {
		reverse_proxy backend:3000
	}
	handle {
		reverse_proxy core:8080 {
			flush_interval -1
		}
	}
}
