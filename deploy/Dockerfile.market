# syntax=docker/dockerfile:1
#
# Compralo — AutoBuy market simulator.
#
#   build context: the repository root (compose passes `..`)
#   ignore file:   deploy/Dockerfile.market.dockerignore
#
# Zero dependencies: a single node:http server. The `source` stage exists so the
# runtime layer only ever receives the one file it needs.

FROM node:22-alpine AS source
WORKDIR /src
COPY autobuy/packages/market/package.json ./package.json
COPY autobuy/packages/market/server.js ./server.js

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    MARKET_PORT=4000

COPY --from=source /src/ ./

RUN chown -R node:node /app
USER node

EXPOSE 4000

# The simulator has no /health route; GET /retailers is its cheapest 200.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.MARKET_PORT||4000)+'/retailers').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

CMD ["node", "server.js"]
