# syntax=docker/dockerfile:1
#
# Compralo — P4 money service.
#
#   build context: the repository root (compose passes `..`)
#   ignore file:   deploy/Dockerfile.money.dockerignore (BuildKit picks it up by name)
#
# MONEY_DIR is a build argument because P4's source has moved once already: it was
# p4/ before the "directory structure" merge and is money/ after it, and p4/zinc.mjs
# is still orphaned outside both. Whichever directory is canonical, point this at it
# from deploy/.env — the whole directory is copied, so an extra module such as
# zinc.mjs is picked up without another edit here.
#
# money.mjs refuses to boot unless STRIPE_SECRET_KEY starts with sk_test_, and zinc.mjs
# (when present) unless ZINC_API_KEY starts with zn_test_. Both come from the environment
# at RUN time — no key is ever baked into an image layer.

# ---- deps: production dependencies only, resolved from the committed lockfile ----
FROM node:22-alpine AS deps
ARG MONEY_DIR=money
WORKDIR /app
COPY ${MONEY_DIR}/package.json ${MONEY_DIR}/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---- runtime ---------------------------------------------------------------------
FROM node:22-alpine AS runtime
ARG MONEY_DIR=money
WORKDIR /app

ENV NODE_ENV=production \
    PORT=4242

COPY --from=deps /app/node_modules ./node_modules
# node_modules and .env are filtered by Dockerfile.money.dockerignore, so this is
# just the source: money.mjs, zinc.mjs if it exists, package.json, fixtures.sh.
COPY ${MONEY_DIR}/ ./

# node:22-alpine ships an unprivileged `node` user (uid 1000). Nothing here is written to.
RUN chown -R node:node /app
USER node

EXPOSE 4242

# No curl in the image on purpose: Node 22 has global fetch.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||4242)+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

# Equivalent to `npm start`: in a container the env comes from compose, never a file.
CMD ["node", "money.mjs"]
